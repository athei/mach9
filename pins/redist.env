# Third-party inputs the build pins. The *_URL and *_SHA256 pairs are
# artifacts bundle-wine.sh downloads and installs. The *_VERSION and
# *_SHA256 pairs are release tarballs another script downloads: LLVM_MINGW_*
# the toolchain of a CI build (bin/ci/llvm-mingw.sh), SPARKLE_* the updater
# of Mach9.app (launcher/scripts/fetch-sparkle.sh). The checksum is what
# validates a download or a cached copy, so bumping a version means changing
# both lines. The *_GIT_* entries are sources build-dxmt.sh, build-mesa.sh,
# build-gstreamer.sh, build-vk-gl-cts.sh and
# build-vulkan-validation-layers.sh compile, pinned by tag (or branch) and
# commit. The sources of our own forks (Wine, FEX, Mesa, DXMT,
# vkd3d-proton) are named by the *-src.ref files next to this one instead.

# DXMT's shader compiler (airconv) links LLVM 15 statically and nothing else.
# There is no arm64 LLVM 15 to install, so build-dxmt.sh builds its static
# libraries once from this tag and checks that the tag is at the commit.
LLVM15_GIT_URL=https://github.com/llvm/llvm-project
LLVM15_GIT_TAG=llvmorg-15.0.7
LLVM15_GIT_COMMIT=8dfdcc7b7bf66834a761bd8de445840ef68e4d1a

# The Vulkan loader (libvulkan.1.dylib), which win32u.so loads and which
# loads KosmicKrisp. Homebrew's vulkan-loader bottle is built for a newer
# macOS than the floor, so build-mesa.sh builds the Khronos loader from this
# tag for the floor, against the headers of the same SDK release below, and
# checks that each tag is at its commit. Bump both together.
VULKAN_HEADERS_GIT_URL=https://github.com/KhronosGroup/Vulkan-Headers
VULKAN_HEADERS_GIT_TAG=vulkan-sdk-1.4.363.0
VULKAN_HEADERS_GIT_COMMIT=6802bb4733b63ed5efd3adb308a6c885ef180ea1
VULKAN_LOADER_GIT_URL=https://github.com/KhronosGroup/Vulkan-Loader
VULKAN_LOADER_GIT_TAG=vulkan-sdk-1.4.363.0
VULKAN_LOADER_GIT_COMMIT=fa218055ff4948b159f31d43f800c808a13d51df

# VK-GL-CTS, the Khronos conformance tests, for deqp-vk, which the deqp-vk
# suite of the conformance runner runs against KosmicKrisp. Not part of the
# bundle: build-vk-gl-cts.sh builds it on demand from this tag, the Vulkan
# CTS release Mesa's CI builds deqp-vk from (DEQP_VK_VERSION in Mesa's
# .gitlab-ci/container/build-deqp.sh), and checks that the tag is at the
# commit. The sources it builds on are pinned by its own
# external/fetch_sources.py.
VK_GL_CTS_GIT_URL=https://github.com/KhronosGroup/VK-GL-CTS
VK_GL_CTS_GIT_TAG=vulkan-cts-1.4.7.0
VK_GL_CTS_GIT_COMMIT=e272471311301a35aae6364def1a3f5ea35215f7

# Khronos' Vulkan validation layers, which checks of the bundle run under.
# Not part of the bundle: build-vulkan-validation-layers.sh builds them on
# demand from this tag, the SDK release of the Vulkan loader above, and
# checks that the tag is at the commit. The sources they build on are pinned
# by the tag's own scripts/known_good.json; the script checks that its
# Vulkan-Headers are the ones pinned above. Bump with the loader.
VULKAN_VALIDATION_LAYERS_GIT_URL=https://github.com/KhronosGroup/Vulkan-ValidationLayers
VULKAN_VALIDATION_LAYERS_GIT_TAG=vulkan-sdk-1.4.363.0
VULKAN_VALIDATION_LAYERS_GIT_COMMIT=15c64e73db67e27ff0215708fbe48684a35c6827

# GStreamer, which winegstreamer.so links, from the monorepo at this tag:
# build-gstreamer.sh builds it with the plugins and FFmpeg decoders Wine's
# media code uses and checks that the tag is at the commit. The monorepo's
# wraps pin glib and its dependencies by tarball checksum; its FFmpeg wrap
# names a branch of GStreamer's meson port of FFmpeg, so the commit that
# build uses is pinned here and fetched by hash instead. Bump the FFmpeg
# branch and commit together with the tag, to the branch the new tag's
# subprojects/FFmpeg.wrap names.
GSTREAMER_GIT_URL=https://github.com/GStreamer/gstreamer
GSTREAMER_GIT_TAG=1.28.8
GSTREAMER_GIT_COMMIT=1b2a95a1b72787cda146b46df9605b168e5b683b
GSTREAMER_FFMPEG_GIT_URL=https://gitlab.freedesktop.org/gstreamer/meson-ports/ffmpeg.git
GSTREAMER_FFMPEG_GIT_BRANCH=meson-7.1.1
GSTREAMER_FFMPEG_GIT_COMMIT=cde7209117ec2be9da087b9e5f96d48450fdecd2

# The Python modules Mesa's build scripts need (mako with its dependency
# markupsafe, packaging, PyYAML), as pip requirements. build-mesa.sh installs
# exactly these into its virtual environment and makes the environment
# again when this line changes.
MESA_PYTHON_REQUIREMENTS="mako==1.4.3 markupsafe==3.0.4 packaging==26.3 pyyaml==6.0.3"

# mtld3d, the D3D9 implementation, from its release tarball. From v0.14.0 on
# it carries ARM64X builds of its 64-bit DLLs, which the bundle installs.
MTLD3D_URL=https://github.com/athei/mtld3d/releases/download/v0.15.3/mtld3d.tar.xz
MTLD3D_SHA256=038f00c9d868a2fcb71034dac645df1fa1500a4b4056f845e400e777e7a4a294

# Uno Fluent Icons, an open replacement for Segoe MDL2 Assets and Segoe Fluent
# Icons, from the uno.fonts repository at a commit. Not its Uno MDL2 Assets
# variant, which draws other icons at some of the same code points. The
# family name must stay Symbols, which wine.inf aliases. A bump needs a new
# licenses/uno-fluent-icons.txt if the font's sources changed.
UNO_FLUENT_ICONS_URL=https://raw.githubusercontent.com/unoplatform/uno.fonts/f2a721469ab98f39b369961cb24339d7a90e39e8/webfonts/Uno%20Fluent%20Icons/uno-fluentui-assets.ttf
UNO_FLUENT_ICONS_SHA256=4b81f01d293bf23093c79f9c4588444dd97cde006220f8fc01488dd530c11006

# The llvm-mingw release a CI build compiles the PE code with:
# llvm-mingw-<version>-ucrt-macos-universal.tar.xz of
# github.com/mstorsjo/llvm-mingw, which bin/ci/llvm-mingw.sh downloads and
# checks against the SHA-256. A local build uses whatever MINGW_DIR holds.
LLVM_MINGW_VERSION=20261104
LLVM_MINGW_SHA256=66cbd5178c4a71b0d473e68ede172f8eb7d15d023e67f39201d0a69e21f6bf3c

# Sparkle, the updater Mach9.app links and ships: Sparkle-<version>.tar.xz of
# github.com/sparkle-project/Sparkle, which launcher/scripts/fetch-sparkle.sh
# downloads and checks against the SHA-256. Bump both together. The checksum
# is over the release tarball as published; recompute it with
# `shasum -a 256` and never take it from anywhere but a download you just
# made yourself.
SPARKLE_VERSION=2.10.1
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
