#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_image_int64 : require
// The adds of smoke/vkatomic64.c, all on one texel of an R64_UINT image:
// texel (0, 0) of layer 1 of a 2D array image (modes 0 and 1), or of slice 1
// of a 3D image (mode 2). Mode 0 adds through the 2D array view alone; mode
// 1 adds through the 2D view of layer 1 in odd invocations and through the 2D
// array view in even ones; mode 2 through the 2D view of slice 1 in odd
// invocations and the 3D view in even ones. imageAtomicAdd is always one of
// KosmicKrisp's locked 64-bit atomics. vkatomic64.comp.h is its SPIR-V:
// glslangValidator -V --target-env vulkan1.3 --vn vkatomic64_comp -o vkatomic64.comp.h vkatomic64.comp

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, r64ui) uniform u64image2D single;
layout(set = 0, binding = 1, r64ui) uniform u64image2DArray layers;
layout(set = 0, binding = 2, r64ui) uniform u64image3D volume;

layout(push_constant) uniform Mode
{
    uint mode;
};

void main()
{
    bool odd = (gl_GlobalInvocationID.x & 1u) != 0u;

    if (mode != 0u && odd)
        imageAtomicAdd(single, ivec2(0, 0), 1ul);
    else if (mode == 2u)
        imageAtomicAdd(volume, ivec3(0, 0, 1), 1ul);
    else
        imageAtomicAdd(layers, ivec3(0, 0, 1), 1ul);
}
