#version 450
// The writes of smoke/vkalias.c: word i of the storage buffer (mode 0), or
// texel (i % width, i / width) of the storage image (mode 1), gets
// seed ^ (i * 2654435761). vkalias.comp.h is its SPIR-V:
// glslangValidator -V --target-env vulkan1.3 --vn vkalias_comp -o vkalias.comp.h vkalias.comp
layout(local_size_x = 64) in;

layout(push_constant) uniform Push
{
    uint mode;
    uint count;
    uint width;
    uint seed;
} pc;

layout(std430, binding = 0) writeonly buffer Words
{
    uint words[];
} buf;

layout(binding = 1, r32ui) uniform writeonly uimage2D img;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count)
        return;
    uint value = pc.seed ^ (i * 2654435761u);
    if (pc.mode == 0u)
        buf.words[i] = value;
    else
        imageStore(img, ivec2(int(i % pc.width), int(i / pc.width)), uvec4(value));
}
