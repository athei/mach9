#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

// The atomic64-words and atomic64-one-word cases: each invocation adds 1
// <adds> times to its own 64-bit word of a storage buffer, or to word 0.
// A 64-bit atomicAdd is always a locked atomic on KosmicKrisp.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Counters
{
    uint64_t counters[];
};

layout(push_constant) uniform Dispatch
{
    uint one_word;
    uint adds;
};

void main()
{
    uint word = one_word != 0u ? 0u : gl_GlobalInvocationID.x;

    for (uint i = 0u; i < adds; i++)
        atomicAdd(counters[word], 1ul);
}
