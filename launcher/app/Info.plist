<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>gamelauncher</string>
	<key>CFBundleIconFile</key>
	<string>mach9</string>
	<key>CFBundleIdentifier</key>
	<string>app.mach9</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Mach9</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- No CFBundleShortVersionString or CFBundleVersion: the Makefile
	     stamps both into the bundle from the workspace version in the root
	     Cargo.toml (launcher/scripts/version.sh). -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<!-- Game Mode. macOS turns it on for an app in the games category while
	     the app is fullscreen and frontmost. LSSupportsGameMode declares the
	     app eligible, and GCSupportsGameMode does the same for the Game
	     Controller side, which raises the polling rate of Bluetooth
	     controllers. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>
	<!-- The bundled arm64 wine's own floor. Matches
	     MACOSX_DEPLOYMENT_TARGET in .cargo/config.toml and the Dock tile
	     plug-in's Info.plist. -->
	<key>LSMinimumSystemVersion</key>
	<string>26.4</string>
	<key>NSDockTilePlugIn</key>
	<string>GameLauncherDockTile.docktileplugin</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Uses the microphone for in-game voice features.</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- Sparkle. Every copy polls the SUFeedURL it shipped with for good,
	     so the URL is on a host we control: mach9.app, the repository's
	     GitHub Pages site, which serves the appcast of the latest release.
	     0.1.0 to 0.2.0-rc.2 shipped with hosts that no longer exist; see
	     "Updates in the field" in docs/maintenance.md.
	     SUPublicEDKey is the public half of Sparkle's EdDSA signing key;
	     the private half is kept outside the repository. PlistBuddy strips
	     these comments, so edit this file by hand. -->
	<key>SUFeedURL</key>
	<string>https://mach9.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>I3lqkTv6m+kA6p2XlMNfNItk32X19llHw9qFJc+3DX8=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- No automatic downloads and installs, and no checkbox in the update
	     window to turn them on: a background check before a game launch
	     can download within its timeout and install on quit while the
	     game runs from this bundle. -->
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
</dict>
</plist>
